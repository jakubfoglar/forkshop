#!/usr/bin/env bash
# Forkshop live-AI hook. Forwards Read/Edit/Write/MultiEdit tool results to the
# Forkshop dev server. Fire-and-forget; never blocks Claude or fails if Forkshop
# isn't running.
#
# Tries ports 3000-3009 to handle the case where Next picks an alternate port
# (3000 taken by something else). Override the range by exporting
# FORKSHOP_DEV_PORTS, or pin a full URL with FORKSHOP_DEV_URL.
set -uo pipefail
command -v jq >/dev/null 2>&1 || exit 0

input="$(cat)"
tool="$(printf '%s' "$input" | jq -r '.tool_name // empty')"
case "$tool" in
  Edit|Write|MultiEdit|Read) ;;
  *) exit 0 ;;
esac

file_path="$(printf '%s' "$input" | jq -r '.tool_input.file_path // empty')"
case "$file_path" in
  *.ts|*.tsx|*.mdx|*.css) ;;
  *) exit 0 ;;
esac

session_id="$(printf '%s' "$input" | jq -r '.session_id // "default"')"

action="edit"
case "$tool" in
  Read)  action="read" ;;
  Write) action="create" ;;
esac

payload="$(jq -n \
  --arg agent "claude-code" \
  --arg label "Claude" \
  --arg sid "$session_id" \
  --arg fp "$file_path" \
  --arg act "$action" \
  '{agent: $agent, agentLabel: $label, sessionId: $sid, file: $fp, action: $act, ts: (now * 1000 | floor)}')"

post() {
  curl -sS -X POST "$1" \
    -H 'content-type: application/json' \
    -d "$payload" \
    --max-time 1 \
    --write-out '%{http_code}' \
    --output /dev/null \
    2>/dev/null || echo "000"
}

# If user pinned a full URL, use it. Otherwise sweep the port range until one accepts.
if [ -n "${FORKSHOP_DEV_URL:-}" ]; then
  post "${FORKSHOP_DEV_URL}/api/forkshop/agent-activity" >/dev/null &
  disown -a 2>/dev/null || true
  exit 0
fi

ports="${FORKSHOP_DEV_PORTS:-3000 3001 3002 3003 3004 3005 3006 3007 3008 3009}"
(
  for port in $ports; do
    code="$(post "http://localhost:$port/api/forkshop/agent-activity")"
    if [ "$code" = "200" ]; then
      break
    fi
  done
) &
disown -a 2>/dev/null || true
exit 0
