{
  "name": "forkshop",
  "version": "0.3.1",
  "private": false,
  "publishConfig": { "access": "public" },
  "type": "module",
  "license": "MIT",
  "description": "CLI for installing and updating Forkshop in a Next.js project.",
  "homepage": "https://forkshop.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakubfoglar/forkshop.git",
    "directory": "packages/cli"
  },
  "bin": { "forkshop": "./dist/index.js" },
  "files": ["dist", "LICENSE"],
  "exports": {
    ".": "./dist/index.js",
    "./manifest-builder": "./src/manifest-builder.ts",
    "./manifest-schema": "./src/manifest-schema.ts"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ignore-pattern 'src/__fixtures__/**'",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "picocolors": "^1.0.1",
    "prompts": "^2.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/prompts": "^2.4.9",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
