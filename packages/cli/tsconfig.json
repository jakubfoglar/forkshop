{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*", "tests/**/*"],
  // Fixture files contain @fogma/* imports that intentionally don't resolve
  // from this package — they're read as raw strings by the test suite.
  "exclude": ["node_modules", "dist", "src/__fixtures__"]
}
