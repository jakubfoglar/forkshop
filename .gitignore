# Pencil tool cache (root-level working dir created by the pencil MCP / CLI).
# Tracked design sources live under docs/design/* instead.
designs/

# Defensive: prevent rogue Forkshop positions if FORKSHOP_POSITIONS_PATH is unset.
# Real positions live per-app under apps/*/app/demo/positions.json (or wherever the
# app's forkshop.config.tsx points).
apps/docs/app/forkshop/

# Per-environment Forkshop drag positions — not source.
apps/*/app/*/positions.json

# Private docs — strategy + user-testing feedback + persona analyses.
# These contain opinionated business thinking or named participants and
# are intentionally kept out of new commits. Note: gitignoring does NOT
# remove the files from prior commits — for true privacy, move them to
# a separate private location and accept that history retains a copy.
docs/strategy/
docs/feedback/
docs/2026-05-17-multi-persona-audit.md
docs/analytics-umami.md
